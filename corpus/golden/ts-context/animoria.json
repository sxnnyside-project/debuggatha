source":{"file":"CLAUDE.md","detail":"Section \"TypeScript Profile (`packages/animoria-ui`, `packages/animoria-vscode`, `packages/animoria-contracts`, `apps/animoria-sandbox`)\""}},{"id":"CLAUDE.md:8","description":"Kotlin Profile (`packages/animoria-jetbrains`)","source":{"file":"CLAUDE.md","detail":"Section \"Kotlin Profile (`packages/animoria-jetbrains`)\""}},{"id":"CLAUDE.md:9","description":"4. Task Runner Abstraction Layer (`just`)","source":{"file":"CLAUDE.md","detail":"Section \"4. Task Runner Abstraction Layer (`just`)\""}},{"id":"CLAUDE.md:10","description":"5. Core Architectural Invariants","source":{"file":"CLAUDE.md","detail":"Section \"5. Core Architectural Invariants\""}}],"sources":[".editorconfig","CLAUDE.md","CONTRIBUTING.md","biome.json"]},"understanding":{"confidence":"high","openQuestions":[]}},"policy":{"id":"f85c4560840f1e99","rules":[{"id":"a01-broken-access-control","statement":"Enforce authorization checks on all authenticated endpoints. Ensure a user cannot access or modify resources belonging to another user (IDOR prevention).","category":"security","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/owasp","packVersion":"2.0.0"}},{"id":"a02-cryptographic-failures","statement":"Never store passwords in plaintext or with a fast general-purpose hash (MD5, SHA-1, or bare SHA-256). Use a slow, salted, password-specific algorithm (bcrypt, scrypt, or Argon2). Encrypt sensitive data in transit (TLS) and at rest.","category":"security","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/owasp","packVersion":"2.0.0"}},{"id":"a03-injection","statement":"Never interpolate user input directly into SQL queries, NoSQL queries, OS commands, or LDAP queries. Use parameterized queries or safe ORMs.","category":"security","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/owasp","packVersion":"2.0.0"}},{"id":"a04-insecure-design","statement":"Threat-model security-critical flows (authentication, payments, access control, account recovery) before implementation, not as a retrofit. Do not rely solely on input validation to compensate for a flow that is unsafe by design — for example, a password-recovery endpoint that returns a different response depending on whether the email exists.","category":"architecture","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/owasp","packVersion":"2.0.0"}},{"id":"a05-security-misconfig","statement":"Do not expose detailed error messages or stack traces in production API responses.","category":"security","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/owasp","packVersion":"2.0.0"}},{"id":"a06-vulnerable-components","statement":"Track the exact versions of every third-party dependency and remove unused ones. Do not knowingly ship a dependency with a publicly disclosed, unpatched CVE relevant to how it is used.","category":"security","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/owasp","packVersion":"2.0.0"}},{"id":"a07-auth-failures","statement":"Enforce strong password policies, implement rate limiting on login endpoints to prevent brute-forcing, and invalidate session tokens on logout.","category":"security","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/owasp","packVersion":"2.0.0"}},{"id":"a08-software-data-integrity","statement":"Verify the integrity of software updates, CI/CD pipeline artifacts, and critical serialized data (e.g. via digital signatures or checksums) before trusting or deploying them. Do not deserialize untrusted data without an integrity check.","category":"security","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/owasp","packVersion":"2.0.0"}},{"id":"a09-logging-monitoring-failures","statement":"Log authentication attempts, access-control failures, and input-validation failures with enough context to support incident investigation. Never log sensitive data — passwords, tokens, full card numbers, PII — in plaintext.","category":"security","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/owasp","packVersion":"2.0.0"}},{"id":"a10-ssrf","statement":"Validate and sanitize any user-supplied URL or hostname before the server uses it to make an outbound request. Enforce an allowlist of permitted destinations rather than a denylist, and block requests to internal/link-local address ranges.","category":"security","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/owasp","packVersion":"2.0.0"}},{"id":"aria-roles","statement":"Do not use interactive ARIA roles (e.g., `role=\"button\"`) on non-interactive elements (like `<div>` or `<span>`) without also implementing `tabindex` and keyboard event handlers (`keydown`, `keyup`). Prefer native semantic HTML.","category":"architecture","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/accessibility","packVersion":"1.0.0"}},{"id":"avoid-process-exit","statement":"Avoid calling `process.exit()`. Throw an error and let the application gracefully shut down by closing servers and database connections first.","category":"architecture","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/nodejs","packVersion":"1.0.0"}},{"id":"avoid-regex-dos","statement":"Avoid deeply nested quantifiers (e.g., `(a+)+`) in Regular Expressions that are evaluated against untrusted input.","category":"security","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/performance","packVersion":"1.0.0"}},{"id":"biome:complexity.noStaticOnlyClass","statement":"Biome rule \"complexity.noStaticOnlyClass\" configured","origin":{"kind":"criteria"}},{"id":"biome:formatter.indentStyle","statement":"Biome formatter setting \"indentStyle\" = \"space\"","origin":{"kind":"criteria"}},{"id":"biome:formatter.indentWidth","statement":"Biome formatter setting \"indentWidth\" = 2","origin":{"kind":"criteria"}},{"id":"biome:formatter.lineWidth","statement":"Biome formatter setting \"lineWidth\" = 100","origin":{"kind":"criteria"}},{"id":"biome:linter.recommended","statement":"Biome recommended lint rules: true","origin":{"kind":"criteria"}},{"id":"biome:performance.noDelete","statement":"Biome rule \"performance.noDelete\" configured","origin":{"kind":"criteria"}},{"id":"biome:style.noNonNullAssertion","statement":"Biome rule \"style.noNonNullAssertion\" configured","origin":{"kind":"criteria"}},{"id":"biome:suspicious.noExplicitAny","statement":"Biome rule \"suspicious.noExplicitAny\" configured","origin":{"kind":"criteria"}},{"id":"cache-headers","statement":"Apply `Cache-Control` headers to static assets and idempotent API responses.","category":"performance","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/performance","packVersion":"1.0.0"}},{"id":"CLAUDE.md:1","statement":"Repository Overview","origin":{"kind":"criteria"}},{"id":"CLAUDE.md:10","statement":"5. Core Architectural Invariants","origin":{"kind":"criteria"}},{"id":"CLAUDE.md:2","statement":"1. Repository Purpose & Architecture","origin":{"kind":"criteria"}},{"id":"CLAUDE.md:3","statement":"Package & Module Map","origin":{"kind":"criteria"}},{"id":"CLAUDE.md:4","statement":"2. Where things go","origin":{"kind":"criteria"}},{"id":"CLAUDE.md:5","statement":"3. Stack Profiles & Tooling","origin":{"kind":"criteria"}},{"id":"CLAUDE.md:6","statement":"Rust Profile (`packages/animoria-core-rust`)","origin":{"kind":"criteria"}},{"id":"CLAUDE.md:7","statement":"TypeScript Profile (`packages/animoria-ui`, `packages/animoria-vscode`, `packages/animoria-contracts`, `apps/animoria-sandbox`)","origin":{"kind":"criteria"}},{"id":"CLAUDE.md:8","statement":"Kotlin Profile (`packages/animoria-jetbrains`)","origin":{"kind":"criteria"}},{"id":"CLAUDE.md:9","statement":"4. Task Runner Abstraction Layer (`just`)","origin":{"kind":"criteria"}},{"id":"consistent-formatting","statement":"A formatter (like Prettier, Biome, or rustfmt) must be configured and enforced via CI or pre-commit hooks to eliminate style debates.","category":"style","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/dx","packVersion":"1.1.0"}},{"id":"consistent-type-imports","statement":"Use `import type` for types to ensure they are fully erased during compilation and do not cause side effects in bundlers.","category":"performance","defaultSeverity":"low","origin":{"kind":"pack","packId":"debuggatha/typescript","packVersion":"1.0.0"}},{"id":"CONTRIBUTING.md:1","statement":"Repository Architecture","origin":{"kind":"criteria"}},{"id":"CONTRIBUTING.md:2","statement":"Ecosytem Conventions & Coding Standards","origin":{"kind":"criteria"}},{"id":"CONTRIBUTING.md:3","statement":"1. File Naming Conventions","origin":{"kind":"criteria"}},{"id":"CONTRIBUTING.md:4","statement":"2. Documentation & Commenting Rules","origin":{"kind":"criteria"}},{"id":"CONTRIBUTING.md:5","statement":"Before You Start","origin":{"kind":"criteria"}},{"id":"CONTRIBUTING.md:6","statement":"Pull Request Checklist","origin":{"kind":"criteria"}},{"id":"CONTRIBUTING.md:7","statement":"Commit Style","origin":{"kind":"criteria"}},{"id":"dependency-inversion","statement":"Domain logic (entities, use cases) must not import or depend on infrastructure logic (database drivers, HTTP clients, UI frameworks).","category":"architecture","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/architecture","packVersion":"1.0.0"}},{"id":"deterministic-builds","statement":"Use lockfiles (`package-lock.json`, `Cargo.lock`, `go.sum`) and commit them to version control to guarantee deterministic builds across environments.","category":"architecture","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/release","packVersion":"1.0.0"}},{"id":"document-env-vars","statement":"Every environment variable the code reads must be documented in the repository (an `.env.example`, the README, a compose file, a Dockerfile or a CI workflow), so a new engineer can configure the project without reading the source.","category":"style","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/dx","packVersion":"1.1.0"}},{"id":"editorconfig:{Justfile,justfile,*.just}:indent_size","statement":"EditorConfig \"indent_size\" = \"4\" for {Justfile,justfile,*.just}","origin":{"kind":"criteria"}},{"id":"editorconfig:{Makefile,makefile,*.mk}:indent_style","statement":"EditorConfig \"indent_style\" = \"tab\" for {Makefile,makefile,*.mk}","origin":{"kind":"criteria"}},{"id":"editorconfig:*:charset","statement":"EditorConfig \"charset\" = \"utf-8\" for *","origin":{"kind":"criteria"}},{"id":"editorconfig:*:end_of_line","statement":"EditorConfig \"end_of_line\" = \"lf\" for *","origin":{"kind":"criteria"}},{"id":"editorconfig:*:indent_size","statement":"EditorConfig \"indent_size\" = \"2\" for *","origin":{"kind":"criteria"}},{"id":"editorconfig:*:indent_style","statement":"EditorConfig \"indent_style\" = \"space\" for *","origin":{"kind":"criteria"}},{"id":"editorconfig:*:insert_final_newline","statement":"EditorConfig \"insert_final_newline\" = \"true\" for *","origin":{"kind":"criteria"}},{"id":"editorconfig:*:root","statement":"EditorConfig \"root\" = \"true\" for *","origin":{"kind":"criteria"}},{"id":"editorconfig:*:trim_trailing_whitespace","statement":"EditorConfig \"trim_trailing_whitespace\" = \"true\" for *","origin":{"kind":"criteria"}},{"id":"editorconfig:*.{bat,cmd}:end_of_line","statement":"EditorConfig \"end_of_line\" = \"crlf\" for *.{bat,cmd}","origin":{"kind":"criteria"}},{"id":"editorconfig:*.{rs,py,cs,cpp,cc,cxx,c,h,hpp,swift,kt,kts,java}:indent_size","statement":"EditorConfig \"indent_size\" = \"4\" for *.{rs,py,cs,cpp,cc,cxx,c,h,hpp,swift,kt,kts,java}","origin":{"kind":"criteria"}},{"id":"editorconfig:*.md:trim_trailing_whitespace","statement":"EditorConfig \"trim_trailing_whitespace\" = \"false\" for *.md","origin":{"kind":"criteria"}},{"id":"enforce-readme","statement":"Every repository must have a `README.md` at the root containing local setup instructions, architecture overview, and test commands.","category":"style","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/dx","packVersion":"1.1.0"}},{"id":"eqeqeq","statement":"Always use strict equality (`===` and `!==`) instead of loose equality (`==` and `!=`).","category":"correctness","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/javascript","packVersion":"1.0.0"}},{"id":"explicit-return-types","statement":"Exported module functions must have explicit return types rather than relying on inference.","category":"architecture","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/typescript","packVersion":"1.0.0"}},{"id":"fail-fast","statement":"Validate invariants and arguments at the boundary of a function or class. Throw an error immediately rather than proceeding with invalid state.","category":"architecture","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/architecture","packVersion":"1.0.0"}},{"id":"focus-outline","statement":"Do not set `outline: none` or `outline: 0` in CSS without providing a custom, high-contrast `:focus` state.","category":"style","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/accessibility","packVersion":"1.0.0"}},{"id":"form-labels","statement":"Every form input (e.g., `<input>`, `<select>`, `<textarea>`) must have an associated `<label>`. Use the `for` attribute on the label pointing to the input's `id`, or nest the input inside the label.","category":"style","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/accessibility","packVersion":"1.0.0"}},{"id":"handle-unhandled-rejections","statement":"Do not leave unhandled promise rejections. In newer Node versions, this will terminate the process immediately.","category":"architecture","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/nodejs","packVersion":"1.0.0"}},{"id":"img-alt-text","statement":"All `<img>` elements must have an `alt` attribute. If the image is purely decorative, use `alt=\"\"`.","category":"style","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/accessibility","packVersion":"1.0.0"}},{"id":"immutable-artifacts","statement":"Build artifacts (like Docker images or binaries) must be immutable. Deploy the exact same artifact to staging and production, modifying only the injected environment variables.","category":"architecture","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/release","packVersion":"1.0.0"}},{"id":"leak-mock-restore","statement":"Restore or clear spies and mocked globals (such as `vi.spyOn`, `jest.spyOn`, `sinon.spy`, or environment overrides) in `afterEach` blocks or using `mockRestore` to prevent test state leakage.","category":"reliability","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/testing","packVersion":"1.0.0"}},{"id":"meaningful-errors","statement":"Error messages thrown in the codebase must contain actionable information. Avoid generic errors like `Something went wrong`.","category":"architecture","defaultSeverity":"low","origin":{"kind":"pack","packId":"debuggatha/dx","packVersion":"1.1.0"}},{"id":"n-plus-one-queries","statement":"Do not execute database queries inside loops. Use batching (e.g., DataLoader) or explicit JOIN/eager-loading mechanisms.","category":"performance","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/performance","packVersion":"1.0.0"}},{"id":"no-assertionless-tests","statement":"Every test should contain at least one verifiable assertion (e.g. `expect`, `assert`, or verified thrown exception) to confirm the expected behavior.","category":"reliability","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/testing","packVersion":"1.0.0"}},{"id":"no-async-foreach","statement":"Do not pass an `async` callback to `forEach`. `forEach` ignores the returned promises, so the work is not awaited and its errors are lost; use `for...of` or `await Promise.all(items.map(...))`.","category":"correctness","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/javascript","packVersion":"1.0.0"}},{"id":"no-empty-tests","statement":"Avoid empty test blocks or tests containing only comments. Empty tests give a false sense of test coverage without actually verifying any behavior.","category":"maintainability","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/testing","packVersion":"1.0.0"}},{"id":"no-eval","statement":"Never use `eval()` or pass strings to `setTimeout`/`setInterval`. This is a severe security vulnerability.","category":"security","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/javascript","packVersion":"1.0.0"}},{"id":"no-explicit-any","statement":"Avoid using the `any` type. Use `unknown` if the type is truly dynamic, and apply type narrowing.","category":"correctness","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/typescript","packVersion":"1.0.0"}},{"id":"no-extend-native","statement":"Do not add properties or methods to the prototypes of native objects like `Object`, `Array`, or `String`.","category":"architecture","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/javascript","packVersion":"1.0.0"}},{"id":"no-floating-promises","statement":"Promises must be explicitly awaited, returned, or have `.catch()` called on them.","category":"security","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/typescript","packVersion":"1.0.0"}},{"id":"no-focused-tests","statement":"Do not commit focused tests (such as `it.only`, `test.only`, `describe.only`, `fit`, or `fdescribe`). Focused tests silence the rest of the test suite and can hide regressions.","category":"reliability","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/testing","packVersion":"1.0.0"}},{"id":"no-hardcoded-secrets","statement":"Never hardcode API keys, passwords, or connection strings in source code. Inject them via environment variables or a secure secret manager.","category":"security","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/release","packVersion":"1.0.0"}},{"id":"no-implied-eval","statement":"Avoid using `new Function()` with dynamic strings, as it operates identically to `eval()` and opens XSS vectors.","category":"security","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/javascript","packVersion":"1.0.0"}},{"id":"no-loop-func","statement":"Avoid defining functions inside loops unless they exclusively reference block-scoped variables, otherwise loop closures will capture the final state.","category":"architecture","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/javascript","packVersion":"1.0.0"}},{"id":"no-magic-numbers","statement":"Do not use magic numbers or raw strings in domain logic. Define them as explicit named constants or enums.","category":"style","defaultSeverity":"low","origin":{"kind":"pack","packId":"debuggatha/architecture","packVersion":"1.0.0"}},{"id":"no-shell-interpolation","statement":"Never build a shell command by interpolating or concatenating values into the string passed to `exec`/`execSync`. Use `execFile`/`spawn` with an argument array.","category":"security","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/nodejs","packVersion":"1.0.0"}},{"id":"no-sync-io","statement":"Never use synchronous I/O methods (e.g., `fs.readFileSync`) during request handling or in the main event loop.","category":"performance","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/nodejs","packVersion":"1.0.0"}},{"id":"no-unsafe-enum-assignment","statement":"Prefer string enums or union types over numeric enums. If using numeric enums, always explicitly assign values.","category":"architecture","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/typescript","packVersion":"1.0.0"}},{"id":"no-var","statement":"Use `let` or `const` instead of `var` to ensure block scoping and prevent hoisting bugs.","category":"correctness","defaultSeverity":"low","origin":{"kind":"pack","packId":"debuggatha/javascript","packVersion":"1.0.0"}},{"id":"pagination","statement":"Always implement pagination (cursor or offset) when returning collections of data from an API. Never return unbounded lists.","category":"architecture","defaultSeverity":"critical","origin":{"kind":"pack","packId":"debuggatha/performance","packVersion":"1.0.0"}},{"id":"prefer-abort-controller","statement":"Use `AbortController` to handle request cancellations and timeouts instead of relying on custom timeout logic or event emitters.","category":"architecture","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/nodejs","packVersion":"1.0.0"}},{"id":"prefer-arrow-callbacks","statement":"Use arrow functions for callbacks to preserve the lexical scope of `this`.","category":"architecture","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/javascript","packVersion":"1.0.0"}},{"id":"prefer-as-const","statement":"Use `as const` to infer the narrowest possible literal types rather than explicitly typing out literal unions.","category":"style","defaultSeverity":"low","origin":{"kind":"pack","packId":"debuggatha/typescript","packVersion":"1.0.0"}},{"id":"prefer-node-protocol","statement":"Always use the `node:` protocol when importing core modules (e.g., `import path from 'node:path'`).","category":"security","defaultSeverity":"low","origin":{"kind":"pack","packId":"debuggatha/nodejs","packVersion":"1.0.0"}},{"id":"prefer-nullish-coalescing","statement":"Use the nullish coalescing operator (`??`) instead of logical OR (`||`) when providing default values for nullable variables.","category":"security","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/typescript","packVersion":"1.0.0"}},{"id":"prefer-object-spread","statement":"Use object spread syntax (`{ ...obj }`) instead of `Object.assign()` for shallow copying and merging.","category":"style","defaultSeverity":"low","origin":{"kind":"pack","packId":"debuggatha/javascript","packVersion":"1.0.0"}},{"id":"prefer-readonly","statement":"Mark properties, arrays, and tuples as `readonly` when they are not intended to be mutated.","category":"architecture","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/typescript","packVersion":"1.0.0"}},{"id":"prefer-template-literals","statement":"Use template literals (`\\```) for string interpolation rather than string concatenation (`+`).","category":"style","defaultSeverity":"low","origin":{"kind":"pack","packId":"debuggatha/javascript","packVersion":"1.0.0"}},{"id":"require-await","statement":"Functions declared `async` must contain an `await` expression unless explicitly implementing an interface that requires a Promise.","category":"performance","defaultSeverity":"low","origin":{"kind":"pack","packId":"debuggatha/javascript","packVersion":"1.0.0"}},{"id":"semantic-versioning","statement":"Adhere to Semantic Versioning (SemVer). Do not introduce breaking changes without bumping the major version number.","category":"architecture","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/release","packVersion":"1.0.0"}},{"id":"single-responsibility","statement":"Classes and modules should have exactly one reason to change. Separate data fetching from presentation.","category":"architecture","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/architecture","packVersion":"1.0.0"}},{"id":"strict-null-checks","statement":"Do not use the non-null assertion operator (`!`). Handle nullability explicitly with optional chaining (`?.`) or control flow narrowing.","category":"correctness","defaultSeverity":"medium","origin":{"kind":"pack","packId":"debuggatha/typescript","packVersion":"1.0.0"}},{"id":"unhandled-async-test","statement":"Ensure asynchronous operations inside tests are awaited or returned as Promises. Floating async operations can cause tests to complete prematurely or fail silently.","category":"reliability","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/testing","packVersion":"1.0.0"}},{"id":"use-worker-threads","statement":"Offload CPU-intensive tasks (like crypto hashing or image processing) to `worker_threads` to avoid blocking the event loop.","category":"performance","defaultSeverity":"high","origin":{"kind":"pack","packId":"debuggatha/nodejs","packVersion":"1.0.0"}}],"packRefs":[{"id":"debuggatha/accessibility","version":"1.0.0"},{"id":"debuggatha/architecture","version":"1.0.0"},{"id":"debuggatha/dx","version":"1.1.0"},{"id":"debuggatha/javascript","version":"1.0.0"},{"id":"debuggatha/nodejs","version":"1.0.0"},{"id":"debuggatha/owasp","version":"2.0.0"},{"id":"debuggatha/performance","version":"1.0.0"},{"id":"debuggatha/release","version":"1.0.0"},{"id":"debuggatha/testing","version":"1.0.0"},{"id":"debuggatha/typescript","version":"1.0.0"}],"conflicts":[]}}
