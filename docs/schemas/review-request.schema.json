{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewRequest",
  "description": "What a review is asked to cover.",
  "type": "object",
  "properties": {
    "id": {
      "description": "Stable identifier of the request.",
      "type": "string"
    },
    "scope": {
      "description": "What to review.",
      "$ref": "#/definitions/ReviewScope"
    },
    "depth": {
      "description": "How much to do.",
      "$ref": "#/definitions/ReviewDepth"
    },
    "requestedAt": {
      "description": "When it was requested, ISO 8601.",
      "type": "string",
      "format": "date-time"
    },
    "requestedPackIds": {
      "description": "Packs to add on top of the detected ones.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requestedPolicyId": {
      "description": "A policy id a previous review reported.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "scope",
    "depth",
    "requestedAt",
    "requestedPackIds"
  ],
  "definitions": {
    "ReviewScope": {
      "description": "One scope model: a diff, a list of files and a workspace review differ only in *what* is\nreviewed, not in what a review request is.",
      "oneOf": [
        {
          "description": "No `base` means \"since the last commit\".",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "diff"
            },
            "base": {
              "description": "The base to diff against.",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "description": "A list of files.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "files"
            },
            "paths": {
              "description": "At least one; `create_review_request` refuses an empty list.",
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "paths"
          ],
          "additionalProperties": false
        },
        {
          "description": "The whole repository.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ReviewDepth": {
      "description": "How much a review does.",
      "type": "string",
      "enum": [
        "quick",
        "full",
        "architectural"
      ]
    }
  },
  "additionalProperties": false
}
