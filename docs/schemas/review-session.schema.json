{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewSession",
  "description": "The traceable record of one review in progress: the (immutable) repository context, which\npolicy and packs were selected, and the lifecycle status.",
  "type": "object",
  "properties": {
    "id": {
      "description": "Stable identifier of the session.",
      "type": "string"
    },
    "createdAt": {
      "description": "When it was created, ISO 8601.",
      "type": "string",
      "format": "date-time"
    },
    "request": {
      "description": "What was asked.",
      "$ref": "#/definitions/ReviewRequest"
    },
    "repositoryContext": {
      "description": "The repository as it was when the session started.",
      "$ref": "#/definitions/RepositoryContext"
    },
    "selectedPolicy": {
      "description": "The policy chosen for the review.",
      "$ref": "#/definitions/PolicyReference"
    },
    "selectedPacks": {
      "description": "The packs chosen for the review.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/PackReference"
      }
    },
    "status": {
      "description": "Where the session is in its lifecycle.",
      "$ref": "#/definitions/ReviewLifecycleStatus"
    },
    "execution": {
      "description": "Timing and outcome so far.",
      "$ref": "#/definitions/ExecutionMetadata"
    }
  },
  "required": [
    "id",
    "createdAt",
    "request",
    "repositoryContext",
    "selectedPacks",
    "status",
    "execution"
  ],
  "definitions": {
    "ReviewRequest": {
      "description": "What a review is asked to cover.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable identifier of the request.",
          "type": "string"
        },
        "scope": {
          "description": "What to review.",
          "$ref": "#/definitions/ReviewScope"
        },
        "depth": {
          "description": "How much to do.",
          "$ref": "#/definitions/ReviewDepth"
        },
        "requestedAt": {
          "description": "When it was requested, ISO 8601.",
          "type": "string",
          "format": "date-time"
        },
        "requestedPackIds": {
          "description": "Packs to add on top of the detected ones.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requestedPolicyId": {
          "description": "A policy id a previous review reported.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope",
        "depth",
        "requestedAt",
        "requestedPackIds"
      ],
      "additionalProperties": false
    },
    "ReviewScope": {
      "description": "One scope model: a diff, a list of files and a workspace review differ only in *what* is\nreviewed, not in what a review request is.",
      "oneOf": [
        {
          "description": "No `base` means \"since the last commit\".",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "diff"
            },
            "base": {
              "description": "The base to diff against.",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "description": "A list of files.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "files"
            },
            "paths": {
              "description": "At least one; `create_review_request` refuses an empty list.",
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "paths"
          ],
          "additionalProperties": false
        },
        {
          "description": "The whole repository.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ReviewDepth": {
      "description": "How much a review does.",
      "type": "string",
      "enum": [
        "quick",
        "full",
        "architectural"
      ]
    },
    "RepositoryContext": {
      "description": "One normalized, immutable description of a repository. Everything downstream consumes this\ninstead of touching the file system.",
      "type": "object",
      "properties": {
        "rootDir": {
          "description": "Absolute path of the repository root.",
          "type": "string"
        },
        "generatedAt": {
          "description": "When the context was built, as an ISO 8601 timestamp.",
          "type": "string",
          "format": "date-time"
        },
        "hasGit": {
          "description": "Whether the root is a git repository.",
          "type": "boolean"
        },
        "stack": {
          "description": "The stack: languages, frameworks, tools.",
          "$ref": "#/definitions/StackProfile"
        },
        "capabilities": {
          "description": "The capabilities rules match against.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Capability"
          }
        },
        "dependencies": {
          "description": "What the repository depends on.",
          "$ref": "#/definitions/DependencyProfile"
        },
        "documentation": {
          "description": "What its documentation says.",
          "$ref": "#/definitions/DocumentationProfile"
        },
        "criteria": {
          "description": "Its own criteria.",
          "$ref": "#/definitions/CriteriaProfile"
        },
        "understanding": {
          "description": "What Debuggatha understands and what it does not.",
          "$ref": "#/definitions/UnderstandingProfile"
        }
      },
      "required": [
        "rootDir",
        "generatedAt",
        "hasGit",
        "stack",
        "capabilities",
        "dependencies",
        "documentation",
        "criteria",
        "understanding"
      ],
      "additionalProperties": false
    },
    "StackProfile": {
      "description": "What Stack Detection read from the manifests: the languages, frameworks and tools in use.",
      "type": "object",
      "properties": {
        "languages": {
          "description": "Languages in use.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/StackSignal"
          }
        },
        "frameworks": {
          "description": "Frameworks in use.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/StackSignal"
          }
        },
        "buildSystems": {
          "description": "Build systems (Cargo, Gradle, Vite...).",
          "type": "array",
          "items": {
            "$ref": "#/definitions/StackSignal"
          }
        },
        "packageManagers": {
          "description": "Package managers (npm, pnpm, Composer...).",
          "type": "array",
          "items": {
            "$ref": "#/definitions/StackSignal"
          }
        },
        "runtimes": {
          "description": "Runtimes the code targets.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/StackSignal"
          }
        },
        "platformTargets": {
          "description": "The kinds of product the repository builds.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PlatformTarget"
          }
        },
        "workspaceType": {
          "description": "Single package or monorepo.",
          "$ref": "#/definitions/WorkspaceType"
        },
        "workspaceEvidence": {
          "description": "Why the workspace type was chosen.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Evidence"
          }
        },
        "manifests": {
          "description": "The manifests that were read, relative to the root.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "languages",
        "frameworks",
        "buildSystems",
        "packageManagers",
        "runtimes",
        "platformTargets",
        "workspaceType",
        "workspaceEvidence",
        "manifests"
      ],
      "additionalProperties": false
    },
    "StackSignal": {
      "description": "A detected value (a language, a framework...) and the evidence for it.",
      "type": "object",
      "properties": {
        "value": {
          "description": "The value, such as `rust` or `react`.",
          "type": "string"
        },
        "evidence": {
          "description": "Where it was seen; never empty.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Evidence"
          }
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "description": "A fact and where it comes from. Every claim Debuggatha makes about a repository carries one.",
      "type": "object",
      "properties": {
        "file": {
          "description": "The file the fact comes from, relative to the repository root.",
          "type": "string"
        },
        "detail": {
          "description": "What the file says, in a sentence.",
          "type": "string"
        }
      },
      "required": [
        "file",
        "detail"
      ],
      "additionalProperties": false
    },
    "PlatformTarget": {
      "description": "What kind of product the repository builds.",
      "type": "string",
      "enum": [
        "desktop",
        "mobile",
        "web"
      ]
    },
    "WorkspaceType": {
      "description": "How the repository is laid out.",
      "type": "string",
      "enum": [
        "single-package",
        "monorepo"
      ]
    },
    "Capability": {
      "description": "What the repository is, in normalized terms packs can match on (`typescript`, `react`, ...).",
      "type": "object",
      "properties": {
        "id": {
          "description": "Normalized identifier packs match on, such as `typescript`.",
          "type": "string"
        },
        "kind": {
          "description": "Which group it belongs to.",
          "$ref": "#/definitions/CapabilityKind"
        },
        "confidence": {
          "description": "How sure the detection is.",
          "$ref": "#/definitions/Confidence"
        },
        "evidence": {
          "description": "What it was detected from; never empty.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Evidence"
          }
        },
        "origin": {
          "description": "The kind of source it came from.",
          "$ref": "#/definitions/CapabilityOrigin"
        }
      },
      "required": [
        "id",
        "kind",
        "confidence",
        "evidence",
        "origin"
      ],
      "additionalProperties": false
    },
    "CapabilityKind": {
      "description": "The group a [`Capability`] belongs to.",
      "type": "string",
      "enum": [
        "language",
        "framework",
        "platform",
        "tooling",
        "characteristic"
      ]
    },
    "Confidence": {
      "description": "How sure a detection is.",
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "CapabilityOrigin": {
      "description": "Where the evidence for a capability came from.",
      "type": "string",
      "enum": [
        "manifest",
        "lockfile",
        "config",
        "convention"
      ]
    },
    "DependencyProfile": {
      "description": "What the repository depends on.",
      "type": "object",
      "properties": {
        "lockfiles": {
          "description": "Lockfiles found.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Evidence"
          }
        },
        "declaredVersions": {
          "description": "Dependency versions as declared, by name.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "runtimeConstraints": {
          "description": "Constraints on the runtime (an engines or rust-version field), by name.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "lockfiles",
        "declaredVersions",
        "runtimeConstraints"
      ],
      "additionalProperties": false
    },
    "DocumentationProfile": {
      "description": "What the repository's documentation says about its intent.",
      "type": "object",
      "properties": {
        "sources": {
          "description": "The files that were read.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/DocumentationSource"
          }
        },
        "summary": {
          "description": "A short summary of the intent they state.",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "summary"
      ],
      "additionalProperties": false
    },
    "DocumentationSource": {
      "description": "One documentation file that was read.",
      "type": "object",
      "properties": {
        "file": {
          "description": "Path relative to the repository root.",
          "type": "string"
        },
        "kind": {
          "description": "What kind of document it is.",
          "$ref": "#/definitions/DocumentationKind"
        },
        "title": {
          "description": "Its first heading, when it has one.",
          "type": "string"
        },
        "wordCount": {
          "description": "Length in words.",
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "file",
        "kind",
        "wordCount"
      ],
      "additionalProperties": false
    },
    "DocumentationKind": {
      "description": "The kind of a documentation file.",
      "type": "string",
      "enum": [
        "readme",
        "claude-memory",
        "contributing",
        "architecture",
        "adr",
        "prd",
        "roadmap",
        "other"
      ]
    },
    "CriteriaProfile": {
      "description": "The repository's own criteria, resolved from documentation, configuration and manifests.",
      "type": "object",
      "properties": {
        "rules": {
          "description": "The criteria found.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CriteriaRule"
          }
        },
        "sources": {
          "description": "The files they came from.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "rules",
        "sources"
      ],
      "additionalProperties": false
    },
    "CriteriaRule": {
      "description": "A criterion the repository declares for its own code.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable identifier.",
          "type": "string"
        },
        "description": {
          "description": "The criterion in a sentence.",
          "type": "string"
        },
        "source": {
          "description": "The file or document that states it.",
          "$ref": "#/definitions/Evidence"
        }
      },
      "required": [
        "id",
        "description",
        "source"
      ],
      "additionalProperties": false
    },
    "UnderstandingProfile": {
      "description": "How well Debuggatha understands the repository, and what it still does not.",
      "type": "object",
      "properties": {
        "confidence": {
          "description": "Overall confidence in the understanding.",
          "$ref": "#/definitions/Confidence"
        },
        "openQuestions": {
          "description": "The gaps that remain.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/OpenQuestion"
          }
        }
      },
      "required": [
        "confidence",
        "openQuestions"
      ],
      "additionalProperties": false
    },
    "OpenQuestion": {
      "description": "A question Debuggatha raises because a concrete gap exists; it never invents an answer.",
      "type": "object",
      "properties": {
        "question": {
          "description": "What is unknown.",
          "type": "string"
        },
        "reason": {
          "description": "Why it matters to a review.",
          "type": "string"
        }
      },
      "required": [
        "question",
        "reason"
      ],
      "additionalProperties": false
    },
    "PolicyReference": {
      "description": "A review policy, by its deterministic id (ADR-0005).",
      "type": "object",
      "properties": {
        "id": {
          "description": "The policy's id.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "PackReference": {
      "description": "A pack, by id and exact version, so a finding stays citable after the pack updates (ADR-0002).",
      "type": "object",
      "properties": {
        "id": {
          "description": "The pack's namespaced id, such as `debuggatha/rust`.",
          "type": "string"
        },
        "version": {
          "description": "The pack's semantic version.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "ReviewLifecycleStatus": {
      "description": "The complete, enforced lifecycle of a review. `can_transition` is the single source of truth\nfor what is allowed; nothing outside this file encodes lifecycle logic.",
      "type": "string",
      "enum": [
        "requested",
        "prepared",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "ExecutionMetadata": {
      "description": "Timing and outcome of a review.",
      "type": "object",
      "properties": {
        "source": {
          "description": "What ran it.",
          "$ref": "#/definitions/ReviewSource"
        },
        "startedAt": {
          "description": "When it started, ISO 8601.",
          "type": "string"
        },
        "completedAt": {
          "description": "When it ended, ISO 8601.",
          "type": "string"
        },
        "durationMs": {
          "description": "How long it took, in milliseconds.",
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "description": "The failure, when the review failed.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ReviewSource": {
      "description": "What ran a review.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "The kind of source.",
          "$ref": "#/definitions/SourceKind"
        },
        "name": {
          "description": "Its name.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "SourceKind": {
      "description": "What produced a piece of evidence.",
      "type": "string",
      "enum": [
        "ai-provider",
        "deterministic-analyzer",
        "custom-skill",
        "human-review"
      ]
    }
  },
  "additionalProperties": false
}
