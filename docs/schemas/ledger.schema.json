{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ledger",
  "description": "The persistent record of findings in `.debuggatha/ledger.json`.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "description": "Version of the file format.",
      "type": "integer",
      "minimum": 1
    },
    "repositoryRoot": {
      "description": "The repository the ledger belongs to.",
      "type": "string"
    },
    "entries": {
      "description": "Every finding it tracks.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/LedgerEntry"
      }
    },
    "createdAt": {
      "description": "When it was created, ISO 8601.",
      "type": "string"
    },
    "updatedAt": {
      "description": "When it last changed, ISO 8601.",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "repositoryRoot",
    "entries",
    "createdAt",
    "updatedAt"
  ],
  "definitions": {
    "LedgerEntry": {
      "description": "One finding the ledger tracks: its identity, state, history and latest form.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable identifier.",
          "type": "string"
        },
        "fingerprint": {
          "description": "What makes it the same finding across reviews: file, rule and content, never the line alone.",
          "$ref": "#/definitions/FindingFingerprint"
        },
        "status": {
          "description": "Where it is in the lifecycle.",
          "$ref": "#/definitions/LifecycleStatus"
        },
        "history": {
          "description": "Every state change, oldest first.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/HistoryEvent"
          }
        },
        "latestFinding": {
          "description": "The finding as the latest review reported it.",
          "$ref": "#/definitions/Finding"
        },
        "review": {
          "description": "What the reviews that saw it used.",
          "$ref": "#/definitions/ReviewAssociation"
        }
      },
      "required": [
        "id",
        "fingerprint",
        "status",
        "history",
        "latestFinding",
        "review"
      ],
      "additionalProperties": false
    },
    "FindingFingerprint": {
      "description": "What finding matching keys off: never the line number alone.",
      "type": "object",
      "properties": {
        "file": {
          "description": "The file, relative to the repository root.",
          "type": "string"
        },
        "ruleId": {
          "description": "The rule that raised the finding, when it has one.",
          "type": "string"
        },
        "category": {
          "description": "The category, used when there is no rule id.",
          "type": "string"
        },
        "contentAnchor": {
          "description": "A hash of the flagged code, so the same finding survives a move to another line.",
          "type": "string"
        }
      },
      "required": [
        "file",
        "category"
      ],
      "additionalProperties": false
    },
    "LifecycleStatus": {
      "description": "Reopened is a distinct state from open: it records that a closed finding came back.",
      "type": "string",
      "enum": [
        "open",
        "acknowledged",
        "resolved",
        "dismissed",
        "reopened"
      ]
    },
    "HistoryEvent": {
      "description": "One change of a finding's state, kept as an append-only history.",
      "type": "object",
      "properties": {
        "timestamp": {
          "description": "When it happened, ISO 8601.",
          "type": "string"
        },
        "previousState": {
          "description": "The state before; `None` for the creation.",
          "$ref": "#/definitions/LifecycleStatus"
        },
        "newState": {
          "description": "The state after.",
          "$ref": "#/definitions/LifecycleStatus"
        },
        "origin": {
          "description": "What caused it.",
          "$ref": "#/definitions/TransitionOrigin"
        },
        "comment": {
          "description": "The reason given, when there is one.",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "newState",
        "origin"
      ],
      "additionalProperties": false
    },
    "TransitionOrigin": {
      "description": "What caused a ledger entry to change state.",
      "oneOf": [
        {
          "description": "A review.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "review"
            },
            "sessionId": {
              "description": "The review session.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sessionId"
          ],
          "additionalProperties": false
        },
        {
          "description": "A person.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "manual"
            },
            "actor": {
              "description": "Who, as the person gave it.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "actor"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Finding": {
      "description": "A problem found in the code, always with at least one location and one piece of evidence: no source, no finding.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable identifier of the finding within its review.",
          "type": "string"
        },
        "title": {
          "description": "A short statement of the problem.",
          "type": "string"
        },
        "explanation": {
          "description": "Why it is a problem, in the reviewer's words.",
          "type": "string"
        },
        "severity": {
          "description": "How serious it is if real.",
          "$ref": "#/definitions/Severity"
        },
        "confidence": {
          "description": "How sure the detector is.",
          "$ref": "#/definitions/Confidence"
        },
        "category": {
          "description": "The area it belongs to (security, reliability, architecture...).",
          "type": "string"
        },
        "locations": {
          "description": "Where it is; never empty.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FindingLocation"
          },
          "minItems": 1
        },
        "evidence": {
          "description": "What backs it up; never empty.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Evidence"
          },
          "minItems": 1
        },
        "appliedPolicy": {
          "description": "The policy the review applied, when the finding came from one.",
          "$ref": "#/definitions/PolicyReference"
        },
        "originatingPack": {
          "description": "The pack whose rule produced it.",
          "$ref": "#/definitions/PackReference"
        },
        "recommendations": {
          "description": "What to do about it.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Recommendation"
          }
        }
      },
      "required": [
        "id",
        "title",
        "explanation",
        "severity",
        "confidence",
        "category",
        "locations",
        "evidence",
        "recommendations"
      ],
      "additionalProperties": false
    },
    "Severity": {
      "description": "How serious a finding is if it is real, independent of its [`Confidence`]. Declared from most to least serious, so the derived order is the order of seriousness.",
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ]
    },
    "Confidence": {
      "description": "How sure a detector is that a finding is a real problem, independent of its [`Severity`].",
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "FindingLocation": {
      "description": "Where a finding is: a file and, when known, the lines and columns.",
      "type": "object",
      "properties": {
        "file": {
          "description": "Path relative to the repository root, with `/` separators.",
          "type": "string"
        },
        "lines": {
          "description": "The lines the finding is about; `None` when it concerns the whole file.",
          "$ref": "#/definitions/LineRange"
        },
        "columns": {
          "description": "The columns on the first line, when the finding names an exact span.",
          "$ref": "#/definitions/LineRange"
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false
    },
    "LineRange": {
      "description": "A span of lines or columns, 1-based and inclusive at both ends.",
      "type": "object",
      "properties": {
        "start": {
          "description": "First line (or column) of the span.",
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "description": "Last line (or column) of the span, equal to `start` for a single one.",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "description": "Machine-readable evidence: a discriminated union, never free text.",
      "oneOf": [
        {
          "description": "A passage of the repository's own documentation.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "documentation"
            },
            "file": {
              "description": "The documentation file.",
              "type": "string"
            },
            "excerpt": {
              "description": "The passage quoted.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file",
            "excerpt"
          ],
          "additionalProperties": false
        },
        {
          "description": "A criterion the repository states or implies.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "criteria"
            },
            "ruleId": {
              "description": "Identifier of the criterion.",
              "type": "string"
            },
            "source": {
              "description": "Where the repository states it (a config file or a document).",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "ruleId",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "description": "A rule of a Review Pack.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "review-pack-rule"
            },
            "packId": {
              "description": "The pack the rule belongs to.",
              "type": "string"
            },
            "ruleId": {
              "description": "The rule's identifier within the pack.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "packId",
            "ruleId"
          ],
          "additionalProperties": false
        },
        {
          "description": "A convention of a framework.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "framework-convention"
            },
            "framework": {
              "description": "The framework's name.",
              "type": "string"
            },
            "detail": {
              "description": "The convention, in a sentence.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "framework",
            "detail"
          ],
          "additionalProperties": false
        },
        {
          "description": "A convention of a language.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "language-convention"
            },
            "language": {
              "description": "The language's name.",
              "type": "string"
            },
            "detail": {
              "description": "The convention, in a sentence.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "language",
            "detail"
          ],
          "additionalProperties": false
        },
        {
          "description": "The analyzed code itself.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "code"
            },
            "file": {
              "description": "The file the code is in.",
              "type": "string"
            },
            "lines": {
              "description": "The lines quoted.",
              "$ref": "#/definitions/LineRange"
            },
            "excerpt": {
              "description": "The code, redacted of anything that looks like a secret.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file"
          ],
          "additionalProperties": false
        },
        {
          "description": "The output of an external analyzer, which runs as a separate process.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "external-analyzer"
            },
            "tool": {
              "description": "The tool's name.",
              "type": "string"
            },
            "ruleId": {
              "description": "The tool's own rule identifier.",
              "type": "string"
            },
            "version": {
              "description": "The tool's version, when it reports one.",
              "type": "string"
            },
            "license": {
              "description": "The tool's license, from the analyzer catalog.",
              "type": "string"
            },
            "url": {
              "description": "A page that explains the rule.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tool",
            "ruleId",
            "license"
          ],
          "additionalProperties": false
        },
        {
          "description": "What the optional semantic layer concluded.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "semantic-review"
            },
            "role": {
              "description": "What the model was asked to do.",
              "$ref": "#/definitions/SemanticRole"
            },
            "provider": {
              "description": "The provider that served the request (a local runtime or the client's own model).",
              "type": "string"
            },
            "model": {
              "description": "The model's name, when known.",
              "type": "string"
            },
            "verdict": {
              "description": "The verdict, for a verification.",
              "$ref": "#/definitions/SemanticVerdict"
            },
            "reason": {
              "description": "The reason the model gave, kept only when it quotes the line it is about.",
              "type": "string"
            },
            "topic": {
              "description": "The subject of a detection, when it has one.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "role",
            "provider",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SemanticRole": {
      "description": "What the semantic layer was asked to do with a finding.",
      "type": "string",
      "enum": [
        "verification",
        "detection"
      ]
    },
    "SemanticVerdict": {
      "description": "A model's judgment of a finding a detector raised; it never closes, hides or lowers the finding.",
      "type": "string",
      "enum": [
        "confirmed",
        "doubtful",
        "unsure"
      ]
    },
    "PolicyReference": {
      "description": "A review policy, by its deterministic id (ADR-0005).",
      "type": "object",
      "properties": {
        "id": {
          "description": "The policy's id.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "PackReference": {
      "description": "A pack, by id and exact version, so a finding stays citable after the pack updates (ADR-0002).",
      "type": "object",
      "properties": {
        "id": {
          "description": "The pack's namespaced id, such as `debuggatha/rust`.",
          "type": "string"
        },
        "version": {
          "description": "The pack's semantic version.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "Recommendation": {
      "description": "What to do about a finding: a summary, why, and optionally an example or an exact edit.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Identifier, unique within its finding.",
          "type": "string"
        },
        "action": {
          "description": "The kind of change asked for.",
          "$ref": "#/definitions/RecommendationAction"
        },
        "summary": {
          "description": "One sentence saying what to do.",
          "type": "string"
        },
        "rationale": {
          "description": "Why this is the right change.",
          "type": "string"
        },
        "targetFile": {
          "description": "The file the change belongs in, when not the one the finding is in.",
          "type": "string"
        },
        "targetLines": {
          "description": "The lines the change touches.",
          "$ref": "#/definitions/LineRange"
        },
        "example": {
          "description": "The code before and after, when the fix is not mechanical.",
          "$ref": "#/definitions/RecommendationExample"
        },
        "edit": {
          "description": "An exact replacement, when the fix is mechanical.",
          "$ref": "#/definitions/RecommendationEdit"
        }
      },
      "required": [
        "id",
        "action",
        "summary"
      ],
      "additionalProperties": false
    },
    "RecommendationAction": {
      "description": "What a recommendation asks the reader to do.",
      "type": "string",
      "enum": [
        "replace",
        "remove",
        "add",
        "refactor",
        "configure",
        "document",
        "investigate"
      ]
    },
    "RecommendationExample": {
      "description": "The same code before and after a fix, shown to the reader.",
      "type": "object",
      "properties": {
        "before": {
          "description": "The code as it is.",
          "type": "string"
        },
        "after": {
          "description": "The code as it should be.",
          "type": "string"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "RecommendationEdit": {
      "description": "An exact text replacement on one line, for fixes that are mechanical.",
      "type": "object",
      "properties": {
        "line": {
          "description": "The line the edit applies to.",
          "type": "integer",
          "minimum": 1
        },
        "startColumn": {
          "description": "First column replaced.",
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "description": "Column after the last one replaced.",
          "type": "integer",
          "minimum": 1
        },
        "replacement": {
          "description": "The text that takes the place of the span.",
          "type": "string"
        },
        "safety": {
          "description": "Whether the edit is safe to apply without reading it.",
          "$ref": "#/definitions/EditSafety"
        }
      },
      "required": [
        "line",
        "startColumn",
        "endColumn",
        "replacement",
        "safety"
      ],
      "additionalProperties": false
    },
    "EditSafety": {
      "description": "How far an edit can be trusted to be applied as it is.",
      "type": "string",
      "enum": [
        "safe",
        "review"
      ]
    },
    "ReviewAssociation": {
      "description": "Which review touched an entry, with what.",
      "type": "object",
      "properties": {
        "createdBySessionId": {
          "description": "The review that first reported it.",
          "type": "string"
        },
        "lastUpdatedBySessionId": {
          "description": "The review that last saw it.",
          "type": "string"
        },
        "repositorySnapshot": {
          "description": "The snapshot of the latest review.",
          "$ref": "#/definitions/SnapshotRef"
        },
        "appliedPolicy": {
          "description": "The policy the latest review applied.",
          "$ref": "#/definitions/PolicyReference"
        },
        "appliedPacks": {
          "description": "The packs it applied.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PackReference"
          }
        }
      },
      "required": [
        "createdBySessionId",
        "lastUpdatedBySessionId",
        "repositorySnapshot",
        "appliedPacks"
      ],
      "additionalProperties": false
    },
    "SnapshotRef": {
      "description": "The repository snapshot a review ran against.",
      "type": "object",
      "properties": {
        "generatedAt": {
          "description": "When the snapshot was built, ISO 8601.",
          "type": "string"
        },
        "fingerprint": {
          "description": "Fingerprint of the snapshot.",
          "type": "string"
        }
      },
      "required": [
        "generatedAt",
        "fingerprint"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
