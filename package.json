{
  "name": "debuggatha",
  "displayName": "Debuggatha",
  "description": "AI-powered linter, code auditor, and bad practices analyzer for VS Code",
  "version": "2.0.0",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onView:debuggatha.chatView"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "debuggatha",
          "title": "Debuggatha",
          "icon": "media/debuggatha-icon.svg"
        }
      ]
    },
    "views": {
      "debuggatha": [
        {
          "type": "webview",
          "id": "debuggatha.chatView",
          "name": "Debuggatha"
        }
      ]
    },
    "commands": [
      {
        "command": "debuggatha.openPanel",
        "title": "Open Debuggatha",
        "category": "Debuggatha"
      },
      {
        "command": "debuggatha.configureApiKey",
        "title": "Configure API Key",
        "category": "Debuggatha"
      },
      {
        "command": "debuggatha.clearOutput",
        "title": "Clear Output",
        "category": "Debuggatha"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Debuggatha",
      "properties": {
        "debuggatha.provider": {
          "type": "string",
          "default": "gemini",
          "enum": ["gemini", "claude", "openai", "grok"],
          "enumDescriptions": [
            "Google Gemini",
            "Anthropic Claude",
            "OpenAI / ChatGPT",
            "xAI Grok"
          ],
          "description": "Default AI provider"
        },
        "debuggatha.model": {
          "type": "string",
          "default": "gemini-2.0-flash",
          "description": "Default model ID for the selected provider"
        },
        "debuggatha.defaultPersonality": {
          "type": "string",
          "default": "kind",
          "enum": ["angry", "kind", "wise"],
          "enumDescriptions": [
            "Mean Witch — Sharp, sarcastic, brutal",
            "Kind Witch — Patient, encouraging, clear",
            "Technical Witch — Precise, structured, professional"
          ],
          "description": "Default personality mode"
        },
        "debuggatha.maxFileSize": {
          "type": "number",
          "default": 100000,
          "description": "Maximum file size in bytes to send to the AI (default: 100 KB)"
        },
        "debuggatha.maxFilesPerRequest": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of files to include per request"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.50.0",
    "typescript": "^5.2.0"
  }
}