{
  "name": "debuggatha",
  "version": "0.2.0",
  "description": "The senior code reviewer that understands repository context, applies explicit criteria, and produces traceable findings.",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "Sxnnyside Project",
    "url": "https://github.com/sxnnyside-project"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxnnyside-project/debuggatha.git"
  },
  "homepage": "https://github.com/sxnnyside-project/debuggatha#readme",
  "bugs": {
    "url": "https://github.com/sxnnyside-project/debuggatha/issues"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "biome check --write --linter-enabled=false .",
    "format:check": "biome check --linter-enabled=false .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/bun": "^1.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "tsup": "^8.5.1",
    "turbo": "^2.10.4",
    "typescript": "^5.9.3"
  }
}
