{
  "name": "@debuggatha/mcp",
  "version": "0.1.0",
  "description": "MCP server exposing Debuggatha code review, findings ledger, and repository intelligence to any MCP host.",
  "license": "MIT",
  "author": "Sxnnyside Project",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxnnyside-project/debuggatha.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/sxnnyside-project/debuggatha#readme",
  "bugs": {
    "url": "https://github.com/sxnnyside-project/debuggatha/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-review",
    "debuggatha"
  ],
  "type": "module",
  "mcpName": "io.github.sxnnyside-project/debuggatha",
  "bin": {
    "debuggatha-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@debuggatha/engine": "workspace:*",
    "@types/node": "^22.0.0"
  }
}
