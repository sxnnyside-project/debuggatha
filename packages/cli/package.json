{
  "name": "@debuggatha/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "debuggatha": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "lint": "biome lint .",
    "format": "biome format --write .",
