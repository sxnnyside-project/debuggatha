{
  "name": "debuggatha",
  "displayName": "Debuggatha",
  "description": "The engineering reviewer that remembers — every finding traced to a real rule, tracked from open to resolved, judged against the repo you actually wrote.",
  "version": "0.1.0",
  "publisher": "SxnnysideProject",
  "repository": {
    "type": "git",
    "url": "https://github.com/sxnnyside-project/debuggatha.git"
  },
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/sxnnyside-project/debuggatha#readme",
  "bugs": {
    "url": "https://github.com/sxnnyside-project/debuggatha/issues"
  },
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "categories": [
    "Linters",
    "Testing"
  ],
  "keywords": [
    "code review",
    "static analysis",
    "security",
    "architecture",
    "linter",
    "sarif",
    "debuggatha"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a workspace you have not trusted, only the built-in detectors run. External analyzers are programs found in the workspace, so they stay off until you trust it."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Debuggatha reads files and runs git on disk, which a virtual workspace does not have."
    }
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "node esbuild.config.mjs && node esbuild.config.mjs --tests && node dist-test/run.js",
    "package": "vsce package --no-dependencies",
    "clean": "rm -rf dist dist-test .vscode-test *.vsix"
  },
  "contributes": {
    "commands": [
      {
        "command": "debuggatha.reviewWorkspace",
        "title": "Debuggatha: Review Entire Workspace",
        "icon": "$(search-view-icon)"
      },
      {
        "command": "debuggatha.reviewActiveFile",
        "title": "Debuggatha: Review Current File",
        "icon": "$(file-code)"
      },
      {
        "command": "debuggatha.reviewDiff",
        "title": "Debuggatha: Review Pending Changes",
        "icon": "$(git-compare)"
      },
      {
        "command": "debuggatha.openFinding",
        "title": "Debuggatha: Open Finding Detail",
        "icon": "$(preview)"
      },
      {
        "command": "debuggatha.resolveFinding",
        "title": "Resolve Finding",
        "icon": "$(check)"
      },
      {
        "command": "debuggatha.dismissFinding",
        "title": "Dismiss Finding",
        "icon": "$(close)"
      },
      {
        "command": "debuggatha.reopenFinding",
        "title": "Reopen Finding",
        "icon": "$(reply)"
      },
      {
        "command": "debuggatha.toggleResolvedFindings",
        "title": "Toggle Resolved Findings",
        "icon": "$(filter)"
      },
      {
        "command": "debuggatha.reviewSelection",
        "title": "Debuggatha: Review Selection",
        "icon": "$(selection)"
      },
      {
        "command": "debuggatha.reviewActiveFileWithModel",
        "title": "Debuggatha: Review Current File with a Local Model",
        "icon": "$(sparkle)"
      },
      {
        "command": "debuggatha.cancelReview",
        "title": "Debuggatha: Cancel Review",
        "icon": "$(stop-circle)"
      },
      {
        "command": "debuggatha.showLog",
        "title": "Debuggatha: Show Log",
        "icon": "$(output)"
      },
      {
        "command": "debuggatha.openFindingById",
        "title": "Open Finding Detail"
      },
      {
        "command": "debuggatha.resolveFindingById",
        "title": "Resolve Finding"
      },
      {
        "command": "debuggatha.dismissFindingById",
        "title": "Dismiss Finding"
      },
      {
        "command": "debuggatha.suppressInline",
        "title": "Accept Finding in Code"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "debuggatha.cancelReview",
          "when": "debuggatha.reviewing"
        },
        {
          "command": "debuggatha.reviewSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "debuggatha.openFinding",
          "when": "false"
        },
        {
          "command": "debuggatha.resolveFinding",
          "when": "false"
        },
        {
          "command": "debuggatha.dismissFinding",
          "when": "false"
        },
        {
          "command": "debuggatha.reopenFinding",
          "when": "false"
        },
        {
          "command": "debuggatha.openFindingById",
          "when": "false"
        },
        {
          "command": "debuggatha.resolveFindingById",
          "when": "false"
        },
        {
          "command": "debuggatha.dismissFindingById",
          "when": "false"
        },
        {
          "command": "debuggatha.suppressInline",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "debuggatha.reviewSelection",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "debuggatha"
        }
      ],
      "view/title": [
        {
          "command": "debuggatha.toggleResolvedFindings",
          "when": "view == debuggatha-findings",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "debuggatha.resolveFinding",
          "when": "view == debuggatha-findings && (viewItem == finding-open || viewItem == finding-acknowledged || viewItem == finding-reopened)",
          "group": "inline"
        },
        {
          "command": "debuggatha.dismissFinding",
          "when": "view == debuggatha-findings && (viewItem == finding-open || viewItem == finding-acknowledged || viewItem == finding-reopened)",
          "group": "inline"
        },
        {
          "command": "debuggatha.reopenFinding",
          "when": "view == debuggatha-findings && (viewItem == finding-resolved || viewItem == finding-dismissed)",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "debuggatha-explorer",
          "title": "Debuggatha",
          "icon": "$(check-all)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "debuggatha-findings",
        "contents": "No findings found.\n\n[Review Entire Workspace](command:debuggatha.reviewWorkspace)\n[Review Pending Diff](command:debuggatha.reviewDiff)"
      },
      {
        "view": "debuggatha-intelligence",
        "contents": "Repository not yet analyzed.\n\n[Analyze Repository](command:debuggatha.reviewWorkspace)"
      }
    ],
    "views": {
      "debuggatha-explorer": [
        {
          "id": "debuggatha-intelligence",
          "name": "Repository Intelligence",
          "type": "tree"
        },
        {
          "id": "debuggatha-findings",
          "name": "Findings Ledger",
          "type": "tree"
        }
      ]
    },
    "configuration": {
      "title": "Debuggatha",
      "properties": {
        "debuggatha.extraReviewPacks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Review Packs to apply on top of the ones Debuggatha detects for your stack. Listed packs take precedence when rules conflict."
        },
        "debuggatha.reviewDepth": {
          "type": "string",
          "enum": [
            "quick",
            "full",
            "architectural"
          ],
          "enumDescriptions": [
            "The built-in detectors only. Fastest.",
            "The built-in detectors, plus the external analyzers installed on this machine (Ruff, Biome, gitleaks, ktlint...).",
            "Everything in full, and a review of the whole repository including its architecture (dependency cycles, layer violations, dead code), whichever command you run."
          ],
          "default": "full",
          "description": "How much a review does."
        },
        "debuggatha.reviewOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Review a file when you save it. Only that file is reviewed, quietly, and never widened by reviewDepth."
        },
        "debuggatha.minimumSeverity": {
          "type": "string",
          "enum": [
            "informational",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "default": "informational",
          "description": "The lowest severity shown in the editor (underlines and the Problems panel). The Findings view always lists everything."
        },
        "debuggatha.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "How much the Debuggatha output channel records. The log says what happened and how long it took; it never contains your code."
        },
        "debuggatha.enabledAnalyzers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "eslint",
              "phpstan",
              "clippy",
              "osv-scanner"
            ]
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Analyzers that run code from the project (`eslint`, `phpstan`, `clippy`) or send package names to a service (`osv-scanner`). Off unless listed here. This can only be set in your own user settings, not by a workspace, so a repository cannot switch it on."
        },
        "debuggatha.semantic.provider": {
          "type": "string",
          "enum": [
            "off",
            "ollama",
            "lmstudio"
          ],
          "default": "off",
          "scope": "machine",
          "markdownDescription": "The model on this machine used by **Debuggatha: Review Current File with a Local Model**. Nothing is sent to a model unless you run that command, and only ever to localhost."
        },
        "debuggatha.semantic.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "The model to use. Empty: the first one the runtime has."
        },
        "debuggatha.semantic.url": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Where the runtime listens (only localhost is accepted). Empty: the runtime's default address."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "debuggatha.welcome",
        "title": "Welcome to Debuggatha",
        "description": "The engineering reviewer that remembers — every finding traced to a real rule, tracked from open to resolved, judged against the repo you actually wrote.",
        "steps": [
          {
            "id": "debuggatha.welcome.intro",
            "title": "Get Started",
            "description": "Debuggatha acts as a dedicated engineering reviewer that points out architectural flaws, security issues, and logical errors in your code.\n\n[Review Workspace](command:debuggatha.reviewWorkspace)",
            "media": {
              "markdown": "media/welcome.md"
            }
          },
          {
            "id": "debuggatha.welcome.settings",
            "title": "Configure Review Packs",
            "description": "Debuggatha uses Review Packs to understand how to review your code. By default, it detects your stack and loads the appropriate Foundation bundles.\n\n[Open Settings](command:workbench.action.openSettings?%22debuggatha%22)",
            "media": {
              "markdown": "media/settings.md"
            }
          }
        ]
      }
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@debuggatha/engine": "link:../../packages/engine",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "mocha": "^10.8.2",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@11.5.2"
}
