root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,py,cs,cpp,c,h,hpp,swift}]
indent_size = 4

[Justfile]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

